#!/bin/sh
# Quita del mensaje de commit cualquier coautoria o firma de Claude / Claude Code.
# Hook local (no se versiona): aplica a todo commit hecho en este repo, venga de quien venga.
sed -i -E \
  -e '/^[Cc]o-[Aa]uthored-[Bb]y:.*([Cc]laude|[Aa]nthropic)/d' \
  -e '/^[Cc]laude-[Ss]ession:/d' \
  -e '/Generated with \[?Claude Code/d' \
  "$1"
